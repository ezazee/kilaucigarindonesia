# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# logs
*.log

# aaPanel / server-specific config (not part of the app, differs per server)
.user.ini

# user-uploaded media — runtime data on the server, not source code.
# Committing this would bloat the repo and risk conflicts on `git pull`
# once the admin dashboard's upload feature is actually used in production.
/public/uploads

# AI tool / editor-specific project folders — local config, not app source
.agents/
.claude/
.freebuff/
.windsurf/

# Raw product reference material (docx/PDF catalogs, price lists) used to
# seed the database — internal business documents, not meant to ship in
# a public/production repo.
/product_knowledge/
PRODUCT_KNOWLEDGE.md
